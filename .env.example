# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zhijiao
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/zhijiao_test

# Redis（限频、OTP nonce、register payload、wx state 都用它）
REDIS_URL=redis://localhost:6379

# AI / DashScope (通义千问) —— Plan 1
DASHSCOPE_API_KEY=sk-xxx-replace-me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_USE_MOCK=false

# AI 模型路由覆盖（可选；不设则用 packages/ai/src/tasks.ts 的默认值）
# 命名规则：AI_MODEL_<TASK_KIND> / AI_THINKING_<TASK_KIND> / AI_TIMEOUT_MS_<TASK_KIND> / AI_FALLBACK_MODEL_<TASK_KIND>
# 思考型模型（qwen3.x / deepseek-v4）默认会先输出 reasoning tokens：更慢更贵、正文更短，
# 生成类任务务必显式关闭（tasks.ts 已默认关闭，覆盖时记得一起改）。
# 切到新一代旗舰出卷示例（先核对单价再上生产）：
# AI_MODEL_PAPER_GEN=qwen3.8-max
# AI_MODEL_LESSON_PLAN_GEN=qwen3.8-max
# AI_THINKING_PAPER_GEN=off
# AI_THINKING_LESSON_PLAN_GEN=off
# 备用模型：主模型 JSON 解析/结构校验失败时，重试轮自动切到它（默认出卷/配图为 qwen3.8-max）。
# AI_FALLBACK_MODEL_PAPER_GEN=qwen3.8-max
# 流式默认开启（避免长生成被首字节超时打断）；置 false 退回一次性响应。
# AI_STREAM=true
# AI_REQUEST_TIMEOUT_MS=600000

# Auth / JWT（Plan 2 新）
ACCESS_JWT_SECRET=dev-only-access-secret-change-in-prod   # HS256
OTP_PEPPER=dev-only-otp-pepper-change-in-prod

# 短信（Plan 2 新）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SMS_USE_MOCK=true                # dev 默认 true（控制台打码）；prod 必须 false

# 微信 H5 OAuth（Plan 2 新）
WECHAT_H5_APPID=
WECHAT_H5_SECRET=
WECHAT_OAUTH_USE_MOCK=true       # dev 默认 true

# WeChat Pay / credits (Plan 3)
WECHAT_PAY_USE_MOCK=true
MOCK_WECHAT_PAY_SECRET=dev-only-mock-pay-secret-32bytes-padding
WECHAT_PAY_APPID=wxpay-dev-placeholder
WECHAT_PAY_MCHID=1900000000
CREDIT_PER_YUAN=10
MINOR_MONTHLY_LIMIT_YUAN=200
# Real-mode credentials (required when WECHAT_PAY_USE_MOCK=false)
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PUB_KEY_FILE=
WECHAT_PAY_NOTIFY_HOST=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Demo center (Plan 16). Keep disabled outside local/demo environments.
DEMO_MODE=0
# 注：DEV_USER_ID 在 Plan 2 删除（不再硬编码用户）
