// 智教 数据模型 - Plan 1 范围
// 模块分组：Identity / Curriculum / Question Bank / AI Audit
// 后续 plan 会扩展：Learning Records / Teacher Artifacts / Forecast / Credit / Content

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// === Identity ===

enum Role {
  OPS
  ADMIN
}

enum Persona {
  STUDENT
  TEACHER
  PARENT
}

enum AuthProvider {
  PHONE
  WECHAT_H5
  WECHAT_OPEN
  WECHAT_MINIAPP
}

enum SessionRevokeReason {
  ROTATED
  USER_LOGOUT
  REUSE_DETECTED
  ADMIN_REVOKED
  EXPIRED
}

enum OtpPurpose {
  LOGIN
  BIND_PHONE
}

model User {
  id          String      @id @default(cuid())
  name        String?
  avatarUrl   String?     @map("avatar_url")
  persona     Persona     @default(STUDENT)
  gradeLevel  GradeLevel? @map("grade_level")
  isMinor     Boolean     @default(true) @map("is_minor")
  deletedAt   DateTime?   @map("deleted_at")
  deactivationReason String? @map("deactivation_reason")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt      @map("updated_at")

  roles               UserRole[]
  identities          AuthIdentity[]
  sessions            Session[]
  wallet              Wallet?
  errorBookEntries    ErrorBookEntry[]   // Plan 4
  createdQuestions    Question[]         @relation("CreatedQuestions")  // Plan 8
  classroomMemberships ClassroomMember[]
  teacherAssignments   Assignment[]        @relation("TeacherAssignments")
  studentAssignments   StudentAssignment[] @relation("StudentAssignments")
  createdKpAliases    KpAlias[]          @relation("KpAliasCreator")    // Plan 9
  reviewedKpMatches   KpReconcileMatch[] @relation("KpReconcileReviewer") // Plan 9
  initiatedOpsActions OpsActionLog[]     @relation("OpsActionInitiator")
  opsActionLogs       OpsActionLog[]     @relation("OpsActionTarget")

  @@index([deletedAt])
  @@map("users")
}

model UserRole {
  userId    String   @map("user_id")
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model AuthIdentity {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  provider        AuthProvider
  providerScope   String       @map("provider_scope")
  providerUserId  String       @map("provider_user_id")
  unionId         String?      @map("union_id")
  metadata        Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  lastUsedAt      DateTime?    @map("last_used_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerScope, providerUserId], name: "uniq_identity")
  @@index([provider, unionId])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id                String                @id @default(cuid())
  userId            String                @map("user_id")
  refreshTokenHash  String                @unique @map("refresh_token_hash")
  deviceLabel       String?               @map("device_label")
  ipCreated         String?               @map("ip_created")
  userAgent         String?               @map("user_agent")
  createdAt         DateTime              @default(now()) @map("created_at")
  lastUsedAt        DateTime              @default(now()) @map("last_used_at")
  expiresAt         DateTime              @map("expires_at")
  revokedAt         DateTime?             @map("revoked_at")
  revokedReason     SessionRevokeReason?  @map("revoked_reason")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpRequest {
  id          String     @id @default(cuid())
  phone       String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  ipCreated   String?    @map("ip_created")
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  expiredAt   DateTime?  @map("expired_at")

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

// === Curriculum ===

enum GradeLevel {
  G5
  G6
  G7
  G8
  G9
  G10
  G11
  G12
}

model Subject {
  id        String           @id @default(cuid())
  code      String           @unique         // "math", "chinese", "english"
  name      String                          // "数学", "语文", "英语"
  createdAt DateTime         @default(now()) @map("created_at")

  knowledgePoints KnowledgePoint[]
  questions       Question[]
  classrooms      Classroom[]
  kpAliases       KpAlias[]            // Plan 9

  @@map("subjects")
}

model KnowledgePoint {
  id          String           @id @default(cuid())
  subjectId   String           @map("subject_id")
  code        String                          // 学科内唯一编码（与 subjectId 联合唯一），如 "math-g8-linear-eq-01"
  name        String
  description String?
  difficulty  Int              @default(3)    // 1-5
  parentId    String?          @map("parent_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  subject          Subject            @relation(fields: [subjectId], references: [id])
  parent           KnowledgePoint?    @relation("KPTree", fields: [parentId], references: [id])
  children         KnowledgePoint[]   @relation("KPTree")
  questions        QuestionKPLink[]
  aliases          KpAlias[]          // Plan 9
  reconcileMatches KpReconcileMatch[] // Plan 9

  @@unique([subjectId, code])
  @@map("knowledge_points")
}

// === Question Bank ===

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  FILL_BLANK
  CALCULATION
  PROOF
  ESSAY
}

enum QuestionStatus {
  DRAFT
  REVIEW
  PUBLISHED
  RETIRED
}

model Question {
  id                  String           @id @default(cuid())
  subjectId           String           @map("subject_id")
  stemMd              String           @map("stem_md")
  stemImageKeys       String[]         @default([]) @map("stem_image_keys")
  type                QuestionType
  difficulty          Int              @default(3)
  status              QuestionStatus   @default(DRAFT)
  source              String?
  // Plan 8: USER_ADHOC 题归属 + 去重 hash. PUBLISHED / SEED 题 nullable.
  // onDelete: SetNull — 用户注销时归属可抹（与 ErrorBookEntry.questionId @Restrict 业务含义不同；
  // 后者是审计主链路，前者是归属元数据）。spec §2.3.
  createdByUserId     String?          @map("created_by_user_id")
  normalizedStemHash  String?          @map("normalized_stem_hash")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  subject            Subject            @relation(fields: [subjectId], references: [id])
  createdBy          User?              @relation("CreatedQuestions", fields: [createdByUserId], references: [id], onDelete: SetNull)
  answer             QuestionAnswer?
  knowledgePoints    QuestionKPLink[]
  errorBookEntries   ErrorBookEntry[]   // Plan 4
  assignmentItems    AssignmentItem[]
  variantItem        VariantItem?
  kpReconcileMatches KpReconcileMatch[] // Plan 9

  // partial unique idx (created_by_user_id, normalized_stem_hash) WHERE source='USER_ADHOC' AND IS NOT NULL
  // 由 migration.sql 末尾 raw SQL 追加（Prisma 5 schema 不支持 partial unique）；spec §2.4.

  @@map("questions")
}

model QuestionAnswer {
  questionId  String   @id @map("question_id")
  contentMd   String   @map("content_md")
  solutionMd  String   @map("solution_md")

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_answers")
}

model QuestionKPLink {
  questionId String         @map("question_id")
  kpId       String         @map("kp_id")
  weight     Float          @default(1.0)

  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kp         KnowledgePoint @relation(fields: [kpId], references: [id], onDelete: Cascade)

  @@id([questionId, kpId])
  @@map("question_kp_links")
}

// === AI Audit ===

enum ModelCallStatus {
  SUCCESS
  PARSE_FAILED
  ADAPTER_ERROR
  TIMEOUT
  COMPLIANCE_REJECTED
}

model PromptTemplate {
  id          String       @id @default(cuid())
  name        String
  version     String
  body        String       @db.Text
  // 指纹用于「同 name+version 是否被改动」的内容校验（registry.ensurePromptInDb），
  // 不需要跨表全局唯一——不同 prompt 偶然撞 hash 是可能且无害的。
  fingerprint String
  createdAt   DateTime     @default(now()) @map("created_at")
  retiredAt   DateTime?    @map("retired_at")

  modelCalls  ModelCall[]

  @@unique([name, version])
  @@map("prompt_templates")
}

model ModelCall {
  id               String           @id @default(cuid())
  taskKind         String           @map("task_kind")
  promptTemplateId String?          @map("prompt_template_id")
  model            String
  requestJson      Json             @map("request_json")
  responseJson     Json?            @map("response_json")
  latencyMs        Int?             @map("latency_ms")
  tokensIn         Int?             @map("tokens_in")
  tokensOut        Int?             @map("tokens_out")
  status           ModelCallStatus
  errorMessage     String?          @map("error_message")
  // 故意不建到 User 的外键：审计记录与用户生命周期解耦——删用户不应级联删审计
  userId           String?          @map("user_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  promptTemplate     PromptTemplate?    @relation(fields: [promptTemplateId], references: [id])
  kpReconcileMatches KpReconcileMatch[] // Plan 9

  @@index([taskKind, createdAt])
  @@index([userId, createdAt])
  @@map("model_calls")
}

// === Credit / Billing ===

enum LedgerKind {
  TOPUP
  DEBIT
  COMPENSATION
  ADJUST_ADD
  ADJUST_SUB
}

enum TopupStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum WechatPayEventVerify {
  PENDING
  OK
  SIG_INVALID
  CERT_NOT_FOUND
  PARSE_FAILED
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger    CreditLedger[]

  @@map("wallets")
}

model CreditLedger {
  id              String      @id @default(cuid())
  walletId        String      @map("wallet_id")
  kind            LedgerKind
  delta           Int
  balanceAfter    Int         @map("balance_after")
  idemKey         String      @unique @map("idem_key")
  refTable        String?     @map("ref_table")
  refId           String?     @map("ref_id")
  actionKind      String?     @map("action_kind")
  metadata        Json?
  createdAt       DateTime    @default(now()) @map("created_at")
  createdByUserId String?     @map("created_by_user_id")

  wallet          Wallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([refTable, refId])
  @@map("credit_ledger")
}

model TopupOrder {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  amountCents   Int          @map("amount_cents")
  credits       Int
  status        TopupStatus  @default(CREATED)
  outTradeNo    String       @unique @map("out_trade_no")
  prepayId      String?      @map("prepay_id")
  transactionId String?      @unique @map("transaction_id")
  paidAt        DateTime?    @map("paid_at")
  expiredAt     DateTime     @map("expired_at")
  ipCreated     String?      @map("ip_created")
  userAgent     String?      @map("user_agent")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt      @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiredAt])
  @@index([userId, status, createdAt])
  @@index([userId, paidAt])
  @@map("topup_orders")
}

model WechatPayEvent {
  id            String                @id @default(cuid())
  outTradeNo    String                @map("out_trade_no")
  transactionId String?               @map("transaction_id")
  rawBody       String?               @db.Text @map("raw_body")
  signature     String?
  timestamp     String?
  nonce         String?
  serial        String?
  verifyStatus  WechatPayEventVerify  @default(PENDING) @map("verify_status")
  handled       Boolean               @default(false)
  processedAt   DateTime?             @map("processed_at")
  error         String?
  createdAt     DateTime              @default(now()) @map("created_at")

  @@index([outTradeNo])
  @@index([handled, createdAt])
  @@map("wechat_pay_events")
}

// === Error Book / Variants (Plan 4) ===

enum ErrorRootCause {
  CONCEPT_CONFUSION     // 概念混淆
  READING_ERROR         // 读题失误
  FORMULA_MISUSE        // 公式误用
  CALCULATION_SLIP      // 计算疏漏
  TRANSFER_GAP          // 迁移不足
  OTHER                 // 兜底：AI 无法分类时；产品上需后续 reclassify
}

enum ErrorBookStatus {
  ACTIVE     // 默认错题本视图；进复习队列；error.list 默认只返此态
  ARCHIVED   // 用户主动归档：从默认错题本"移走"；仅归档页（status="ARCHIVED"）可见
  DELETED    // 终态；所有 student-facing 入口视为不存在；DB 行保留作审计
}

enum VariantLevel {
  L1   // 同结构同知识点；改数字 / 改具体值
  L2   // 改条件 / 改题型表象但同知识点
  L3   // 跨题型与现实情境融合；要求知识点迁移
}

model ErrorBookEntry {
  id                  String           @id @default(cuid())
  userId              String           @map("user_id")
  questionId          String           @map("question_id")
  status              ErrorBookStatus  @default(ACTIVE)

  rootCause           ErrorRootCause
  rootCauseReasoning  String           @db.Text @map("root_cause_reasoning")
  actualAnswerMd      String?          @db.Text @map("actual_answer_md")

  reviewCount         Int              @default(0) @map("review_count")
  nextReviewAt        DateTime?        @map("next_review_at")
  lastReviewedAt      DateTime?        @map("last_reviewed_at")

  diagnoseLedgerId    String?          @map("diagnose_ledger_id")
  lastDiagnoseCallId  String?          @map("last_diagnose_call_id")

  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt      @map("updated_at")

  // 安全默认：不 CASCADE（与 Wallet/CreditLedger 同款）；用户注销 / 题库下线由独立 plan 接管
  user                User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  question            Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  variantGroups       VariantGroup[]
  assignmentAnswers   AssignmentAnswer[]

  // ❌ 故意不加 @@unique([userId, questionId])
  //    DELETED entry 允许与新 ACTIVE entry 共存；partial unique index 在 migration 里加（步骤 1.7）
  @@index([userId, status, nextReviewAt])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([questionId])
  @@map("error_book_entries")
}

model VariantGroup {
  id              String         @id @default(cuid())
  entryId         String         @map("entry_id")
  userId          String         @map("user_id")
  creditsCost     Int            @map("credits_cost")
  debitLedgerId   String         @unique @map("debit_ledger_id")
  modelCallId     String?        @map("model_call_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  entry           ErrorBookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  items           VariantItem[]

  @@index([entryId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("variant_groups")
}

model VariantItem {
  id                  String        @id @default(cuid())
  groupId             String        @map("group_id")
  questionId          String?       @unique @map("question_id")
  level               VariantLevel
  position            Int
  stemMd              String        @db.Text @map("stem_md")
  solutionMd          String        @db.Text @map("solution_md")
  knowledgePointHints String[]      @default([]) @map("knowledge_point_hints")
  createdAt           DateTime      @default(now()) @map("created_at")

  group               VariantGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question            Question?     @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([groupId, level])
  @@index([groupId, position])
  @@map("variant_items")
}

// === Plan 10: Classroom Assignments ===

enum ClassroomMemberRole {
  TEACHER
  STUDENT
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssignmentTierLevel {
  BASIC
  CONSOLIDATION
  CHALLENGE
}

enum StudentAssignmentStatus {
  ASSIGNED
  SUBMITTED
  GRADED
}

enum AssignmentGradeStatus {
  UNGRADED
  CORRECT
  PARTIAL
  WRONG
}

model Classroom {
  id          String      @id @default(cuid())
  name        String
  subjectId   String      @map("subject_id")
  gradeLevel  GradeLevel? @map("grade_level")
  createdAt   DateTime    @default(now()) @map("created_at")

  subject     Subject           @relation(fields: [subjectId], references: [id])
  members     ClassroomMember[]
  assignments Assignment[]

  @@map("classrooms")
}

model ClassroomMember {
  classroomId String              @map("classroom_id")
  userId      String              @map("user_id")
  role        ClassroomMemberRole
  createdAt   DateTime            @default(now()) @map("created_at")

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([classroomId, userId])
  @@index([userId, role])
  @@map("classroom_members")
}

model Assignment {
  id                 String           @id @default(cuid())
  classroomId        String           @map("classroom_id")
  teacherUserId      String           @map("teacher_user_id")
  title              String
  status             AssignmentStatus @default(DRAFT)
  source             String
  generationLedgerId String?          @map("generation_ledger_id")
  generationCallId   String?          @map("generation_call_id")
  publishedAt        DateTime?        @map("published_at")
  closedAt           DateTime?        @map("closed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  classroom          Classroom            @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  teacher            User                 @relation("TeacherAssignments", fields: [teacherUserId], references: [id], onDelete: Restrict)
  tiers              AssignmentTier[]
  studentAssignments StudentAssignment[]

  @@index([teacherUserId, status, createdAt])
  @@index([classroomId, status, createdAt])
  @@map("assignments")
}

model AssignmentTier {
  id                 String              @id @default(cuid())
  assignmentId       String              @map("assignment_id")
  level              AssignmentTierLevel
  title              String
  rationaleMd        String?             @db.Text @map("rationale_md")
  createdAt          DateTime            @default(now()) @map("created_at")

  assignment         Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  items              AssignmentItem[]
  studentAssignments StudentAssignment[]

  @@unique([assignmentId, level])
  @@map("assignment_tiers")
}

model AssignmentItem {
  id          String       @id @default(cuid())
  tierId      String       @map("tier_id")
  questionId  String?      @map("question_id")
  position    Int
  stemMd      String       @db.Text @map("stem_md")
  type        QuestionType
  optionsJson Json?        @map("options_json")
  answerMd    String       @db.Text @map("answer_md")
  solutionMd  String       @db.Text @map("solution_md")
  rubricMd    String?      @db.Text @map("rubric_md")
  kpHints     String[]     @default([]) @map("kp_hints")
  createdAt   DateTime     @default(now()) @map("created_at")

  tier        AssignmentTier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  question    Question?          @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answers     AssignmentAnswer[]

  @@unique([tierId, position])
  @@index([questionId])
  @@map("assignment_items")
}

model StudentAssignment {
  id                 String                  @id @default(cuid())
  assignmentId       String                  @map("assignment_id")
  studentUserId      String                  @map("student_user_id")
  tierId             String                  @map("tier_id")
  status             StudentAssignmentStatus @default(ASSIGNED)
  suggestedTier      AssignmentTierLevel?    @map("suggested_tier")
  tierOverrideReason String?                 @map("tier_override_reason")
  submittedAt        DateTime?               @map("submitted_at")
  gradedAt           DateTime?               @map("graded_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  assignment         Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  tier               AssignmentTier     @relation(fields: [tierId], references: [id], onDelete: Restrict)
  student            User               @relation("StudentAssignments", fields: [studentUserId], references: [id], onDelete: Restrict)
  answers            AssignmentAnswer[]

  @@unique([assignmentId, studentUserId])
  @@index([studentUserId, status, createdAt])
  @@map("student_assignments")
}

model AssignmentAnswer {
  id                  String                @id @default(cuid())
  studentAssignmentId String                @map("student_assignment_id")
  itemId              String                @map("item_id")
  answerJson          Json                  @map("answer_json")
  gradeStatus         AssignmentGradeStatus @default(UNGRADED) @map("grade_status")
  teacherFeedbackMd   String?               @db.Text @map("teacher_feedback_md")
  errorBookEntryId    String?               @map("error_book_entry_id")
  gradedAt            DateTime?             @map("graded_at")

  studentAssignment   StudentAssignment @relation(fields: [studentAssignmentId], references: [id], onDelete: Cascade)
  item                AssignmentItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  errorBookEntry      ErrorBookEntry?   @relation(fields: [errorBookEntryId], references: [id], onDelete: SetNull)

  @@unique([studentAssignmentId, itemId])
  @@index([itemId, gradeStatus])
  @@map("assignment_answers")
}

model AssignmentPerformance {
  id            String                @id @default(cuid())
  assignmentId  String                @map("assignment_id")
  studentUserId String                @map("student_user_id")
  itemId        String                @map("item_id")
  gradeStatus   AssignmentGradeStatus @map("grade_status")
  kpIds         String[]              @default([]) @map("kp_ids")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@unique([assignmentId, studentUserId, itemId])
  @@index([studentUserId, createdAt])
  @@index([assignmentId])
  @@map("assignment_performance")
}

// === Plan 9: Knowledge Point Reconciler ===

enum KpAliasSource {
  SEED         // pnpm db:seed 灌入
  CLI_MANUAL   // kp:review 的 alias <kpCode> 学到
}

enum KpReconcileSource {
  ERROR_ANALYSIS  // error.diagnose body sync 调用
  VARIANT_ITEM    // variant.generateForEntry body sync 调用
  TUTOR_ADHOC     // tutor.ask body sync 调用
  BACKFILL        // 一次性 backfill 脚本扫历史 VariantItem
}

enum KpReconcileSourceRefType {
  ERROR_BOOK_ENTRY  // sourceRefId = ErrorBookEntry.id
  VARIANT_ITEM      // sourceRefId = VariantItem.id（实时或 backfill）
  QUESTION          // sourceRefId = Question.id（TUTOR_ADHOC 路径指向 USER_ADHOC 题本身）
}

enum KpReconcileMatchVia {
  EXACT    // KP.name / KP.code 直接命中
  ALIAS    // KpAlias 表命中
  LLM      // 异步 LLM 兑底
  MANUAL   // CLI 人工 approve/remap/alias
}

enum KpReconcileMatchStatus {
  UNMATCHED       // sync 未命中，等异步 LLM
  PENDING_REVIEW  // 等人工：LLM 中档置信 / VARIANT_ITEM 待写 parent
  LINKED          // 已写 QuestionKPLink
  REJECTED        // 人工拒绝
  DROPPED         // LLM 低置信 / NO_MATCH
}

enum KpReconcileReviewReason {
  LLM_CONFIDENCE_BAND
  VARIANT_TO_PARENT_NEEDS_REVIEW
}

model KpAlias {
  id               String        @id @default(cuid())
  subjectId        String        @map("subject_id")
  kpId             String        @map("kp_id")
  normalizedAlias  String        @map("normalized_alias")
  source           KpAliasSource
  createdAt        DateTime      @default(now()) @map("created_at")
  createdByUserId  String?       @map("created_by_user_id")

  subject          Subject        @relation(fields: [subjectId], references: [id])
  kp               KnowledgePoint @relation(fields: [kpId], references: [id])
  createdBy        User?          @relation("KpAliasCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([subjectId, normalizedAlias])
  @@index([kpId])
  @@map("kp_aliases")
}

model KpReconcileMatch {
  id               String                      @id @default(cuid())
  questionId       String                      @map("question_id")
  kpId             String?                     @map("kp_id")
  rawHint          String                      @db.Text @map("raw_hint")
  normalizedHint   String                      @map("normalized_hint")
  source           KpReconcileSource
  sourceRefType    KpReconcileSourceRefType    @map("source_ref_type")
  sourceRefId      String                      @map("source_ref_id")
  matchVia         KpReconcileMatchVia?        @map("match_via")
  confidence       Float?
  status           KpReconcileMatchStatus      @default(UNMATCHED)
  reviewReason     KpReconcileReviewReason?    @map("review_reason")
  modelCallId      String?                     @map("model_call_id")
  reviewedAt       DateTime?                   @map("reviewed_at")
  reviewedByUserId String?                     @map("reviewed_by_user_id")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  question         Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kp               KnowledgePoint?             @relation(fields: [kpId], references: [id], onDelete: SetNull)
  reviewedBy       User?                       @relation("KpReconcileReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  modelCall        ModelCall?                  @relation(fields: [modelCallId], references: [id], onDelete: SetNull)

  @@unique([sourceRefType, sourceRefId, normalizedHint])
  @@index([status, createdAt])
  @@index([questionId])
  @@map("kp_reconcile_matches")
}

// === Plan 6: PII Governance ===

enum OpsActionKind {
  DEACTIVATE_USER
  EXPORT_USER_DATA
  GC_SWEEP_SHORT
  GC_SWEEP_MEDIUM
  GC_SWEEP_ORPHAN
}

model OpsActionLog {
  id           String        @id @default(cuid())
  kind         OpsActionKind
  initiatorId  String?       @map("initiator_id")
  initiatorRef String        @map("initiator_ref")
  targetUserId String?       @map("target_user_id")
  reason       String?
  payload      Json?
  createdAt    DateTime      @default(now()) @map("created_at")

  initiator    User?         @relation("OpsActionInitiator", fields: [initiatorId], references: [id], onDelete: SetNull)
  target       User?         @relation("OpsActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([targetUserId])
  @@map("ops_action_logs")
}
