# Copy to .env.production on the deployment host and replace every placeholder.
# Use with: docker compose --env-file .env.production -f docker-compose.prod.yml ...

# Compose / image
ZHIJIAO_WEB_IMAGE=zhijiao-web:prod
ZHIJIAO_MIGRATOR_IMAGE=zhijiao-migrator:prod
WEB_PORT=3000

# Database / Redis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=zhijiao

# Public app URL. Replace after ICP/domain/cert are ready.
NEXT_PUBLIC_APP_URL=https://example.com

# Auth secrets. Generate unique production values; do not reuse dev/test values.
ACCESS_JWT_SECRET=replace-with-at-least-32-random-bytes
OTP_PEPPER=replace-with-at-least-16-random-bytes

# AI. Production tutoring should use real DashScope credentials.
AI_USE_MOCK=false
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# SMS. Keep mock=true only for pre-ICP/dry-run deployments.
SMS_USE_MOCK=true
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# WeChat H5 OAuth. Keep mock=true until ICP and official account setup are done.
WECHAT_OAUTH_USE_MOCK=true
WECHAT_H5_APPID=
WECHAT_H5_SECRET=

# WeChat Pay. Keep mock=true until ICP, merchant account, APIv3 key, and certs are ready.
WECHAT_PAY_USE_MOCK=true
MOCK_WECHAT_PAY_SECRET=replace-with-at-least-16-random-bytes
WECHAT_PAY_APPID=wxpay-placeholder
WECHAT_PAY_MCHID=1900000000
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PUB_KEY_FILE=
WECHAT_PAY_NOTIFY_HOST=

# Object storage. Keep mock=true until Aliyun OSS is implemented and configured.
STORAGE_USE_MOCK=true
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=

# Business constants
CREDIT_PER_YUAN=10
MINOR_MONTHLY_LIMIT_YUAN=200

# Production guards
DEMO_MODE=0
LOG_LEVEL=info
